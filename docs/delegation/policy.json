  "forbiddenCodeInAddedLines": "\\b(resend|nodemailer|sendgrid|postmark|stripe|sendmail|sendemail|child_process|execSync|spawnSync|execFile)\\b|\\bsend[A-Z]\\w*\\s*\\(|\\bprocess\\s*(\\.|\\[\\s*[\\\"\\'`])\\s*(?!env\\s*\\.\\s*(NODE_ENV|NEXT_PUBLIC_[A-Z0-9_]+)\\b)(env|exit|kill|binding)|from\\s+[\\\"'](node:)?(process|fs|fs/promises|net|http|https|dgram|child_process|worker_threads|vm)[\\\"']|\\brequire\\s*\\(\\s*[\\\"'](node:)?(process|fs|net|http|https|child_process|vm)[\\\"']|\\bfetch\\s*\\(\\s*(?![\\\"'`]/[^/])|\\bmethod\\s*:|\\.(writeFile|appendFile|unlink|rm|rmdir|mkdir)\\w*\\s*\\(|\\beval\\s*\\(|new\\s+Function\\s*\\(|\\bfrom\\s+[\\\"'][^\\\"']*(\\.test|/docs/)|\\bimport\\s*\\(\\s*[\\\"'][^\\\"']*(\\.test|/docs/)|(from|import\\s*\\(|require\\s*\\()\\s*[\\\"'][^\\\"']*/(email|outreach|weeklyEmail|welcomeEmail|passwordReset|emailLog|stripe|auth|session|password|secretBox|accounts|adminOnly|creditWorkerAuth|legal|weeklySend|newsletter|liveCheckAlert|unconfirmedPurge|totp|twoFactor|csp|botCheck|currentUser|rationaleAccess|plans|tiers|pro|promo|searchQuota|terms|disclaimer|cookieText|riskWarning|consentText|brokers)\\w*[\\\"']",
  "amberRequires": {
    "recoveryBackupMaxAgeHours": 24,
    "rollbackTargetMustBeBaseline": true,
    "impactRequired": true,
    "migrationReversibleRequired": true,
    "forbiddenSqlInAddedLines": "\\b(drop\\s+(table|schema|column|database|index|constraint|view|type|trigger|function)|truncate|delete\\s+from|alter\\s+table\\s+\\S+\\s+(alter\\s+column\\s+\\S+\\s+(type|set\\s+not\\s+null)|rename)|update\\s+\\S+\\s+set\\b(?![^;]*\\bwhere\\b))"
  },
  "releaseEvidence": {
    "registerFile": "docs/release-register.json",
    "registerOnlyFiles": [
      "docs/release-register.json"
    ],
    "reviewVerdictRequired": "PASS",
    "evidenceFromGitHub": "CI success (check run 'checks' on the exact commit, or on the PR head of a merge commit, with no failed run) and the nightly backup run time (latest successful scheduled run on main) are read from the GitHub API at release time; the register's own CI/backup fields are not trusted. The review is an attestation: recorded, not provable.",
    "reviewerMustDifferFromAuthor": true,
    "ciSource": "the 'test' job of deploy.yml runs ci.yml on the exact commit and the deploy job needs it"
  },
  "pauseSwitch": {
    "githubRepositoryVariable": "RELEASE_DELEGATION",
    "activeValue": "ACTIVE",
    "pinVariable": "RELEASE_POLICY_SHA256",
    "rule": "Anything other than exactly ACTIVE (unset, empty, PAUSED, active) pauses automatic release. The pin variable must equal the SHA-256 of this file on the live commit."
  },
  "forbiddenRemovedLines": "\\b(currentUser|isAdmin|adminOnly|requireAdmin|requireAuth|tierFeatures|consumeSearch|searchQuota|authorize|authenticate|Forbidden|Unauthorized|plan|tier|quota|subscription|paywall|consent|disclaimer)\\b|\\b(401|403|429)\\b"
}
