  ],
  "amber": [
    "db/**",
    "app/api/**"
  ],
  "green": [
    "docs/**",
    "scripts/*-live-check.mjs",
    "scripts/*-check.mjs",
    "**/*.test.ts",
    "**/*.test.tsx",
    "public/*.png",
    "public/*.jpg",
    "public/*.webp",
    "public/*.svg",
    "app/globals.css",
    "app/icon.svg",
    "app/bonds/**",
    "app/bond-card/**",
    "app/isin-search/**",
    "app/price-drops/**",
    "app/widget/**",
    "app/embed/**",
    "app/report/**",
    "components/*Chart.tsx",
    "components/Logo.tsx",
    "components/CloseButton.tsx",
    "components/BondCard.tsx",
    "components/Frontier.tsx",
    "components/Diversification.tsx",
    "components/PriceDrops*.tsx",
    "lib/formatDate.ts",
    "lib/fmtMin.ts",
    "lib/bondFilter.ts",
    "lib/curveFilter.ts"
  ],
  "protectedEdits": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "scripts/*-check.mjs",
    "scripts/*-live-check.mjs"
  ],
  "forbiddenCodeInAddedLines": "\\b(resend|nodemailer|sendgrid|postmark|stripe|sendmail|sendemail|child_process|execSync|spawnSync)\\b|\\bsend[A-Z]\\w*\\s*\\(|process\\.env(?!\\.(NODE_ENV|NEXT_PUBLIC_[A-Z0-9_]+)\\b)|\\bmethod\\s*:\\s*[\"'`](POST|PUT|PATCH|DELETE)|fetch\\(\\s*[\"'`]https?:|\\bfrom\\s+[\"'][^\"']*(\\.test|/docs/)|\\bimport\\([\"'][^\"']*(\\.test|/docs/)|\\beval\\(|new\\s+Function\\(",
  "amberRequires": {
    "recoveryBackupMaxAgeHours": 24,
    "rollbackTargetMustBeBaseline": true,
    "impactRequired": true,
    "migrationReversibleRequired": true,
    "forbiddenSqlInAddedLines": "\\b(drop\\s+(table|schema|column|database|index|constraint|view|type|trigger|function)|truncate|delete\\s+from|alter\\s+table\\s+\\S+\\s+(alter\\s+column\\s+\\S+\\s+(type|set\\s+not\\s+null)|rename)|update\\s+\\S+\\s+set\\b(?![^;]*\\bwhere\\b))"
  },
  "releaseEvidence": {
    "registerFile": "docs/release-register.json",
    "registerOnlyFiles": [
      "docs/release-register.json"
    ],
    "reviewVerdictRequired": "PASS",
    "evidenceFromGitHub": "CI success (check run 'checks' on the exact commit, or on the PR head of a merge commit, with no failed run) and the nightly backup run time (latest successful scheduled run on main) are read from the GitHub API at release time; the register's own CI/backup fields are not trusted. The review is an attestation: recorded, not provable.",
    "reviewerMustDifferFromAuthor": true,
    "ciSource": "the 'test' job of deploy.yml runs ci.yml on the exact commit and the deploy job needs it"
  },
  "pauseSwitch": {
    "githubRepositoryVariable": "RELEASE_DELEGATION",
    "activeValue": "ACTIVE",
    "pinVariable": "RELEASE_POLICY_SHA256",
    "rule": "Anything other than exactly ACTIVE (unset, empty, PAUSED, active) pauses automatic release. The pin variable must equal the SHA-256 of this file on the live commit."
  }
}
